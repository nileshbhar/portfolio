# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nilesh.dev

# ── Contact form email ───────────────────────────────────────────────
# Submissions are emailed, never stored.
#
# Gmail setup:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character password below (spaces are fine to remove).
#
# SMTP_USER        the Gmail address that sends the email
# SMTP_PASS        its App Password (NOT the normal Gmail password)
# CONTACT_TO_EMAIL where submissions should arrive (can be the same address)
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Optional: use another SMTP provider instead of Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# CONTACT_FROM_EMAIL=

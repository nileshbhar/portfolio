# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nilesh.dev

# Contact form delivery (optional).
# The form posts to /api/contact. If RESEND_API_KEY is not set, the API reports
# that delivery is not configured and the form offers a pre-filled email link instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
